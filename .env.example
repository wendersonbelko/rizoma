# Banco de dados (PostgreSQL 16+)
DATABASE_URL="postgresql://apihub:apihub@localhost:5432/apihub?schema=public"

# Chave de 32 bytes em base64 usada para cifrar segredos no banco (AES-256-GCM).
# Gere com: pnpm setup:keys
ENCRYPTION_KEY=""

# Segredo do Auth.js (cookies e CSRF). Gere com: pnpm setup:keys
AUTH_SECRET=""

# URL pública do hub (ex.: https://apihub.suaempresa.com)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# O token de POST /api/v1/sync é gerado em Configurações → Repositórios.
# Esta variável não é lida.

# Opcional: base para os links de "veja a documentação" mostrados na interface
# (ex.: como configurar o CI). Por padrão aponta para o site de documentação do projeto
# (docs/, publicado no GitHub Pages); aponte para outro lugar (domínio próprio, wiki interna) se preferir.
NEXT_PUBLIC_DOCS_URL="https://wendersonbelko.github.io/rizoma"
