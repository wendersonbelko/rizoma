{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build", "^generate"], "outputs": [".next/**", "!.next/cache/**"] },
    "generate": { "cache": false },
    "dev": { "dependsOn": ["^generate"], "cache": false, "persistent": true },
    "test": { "dependsOn": ["^generate"], "cache": false },
    "typecheck": { "dependsOn": ["^generate"] }
  }
}
